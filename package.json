{
  "name": "smart-fundis",
  "version": "0.0.0",
  "private": true,
  "description": "Smart Fundis monorepo: web (Next.js), convex (backend), ai-service (Python, not an npm workspace)",
  "workspaces": [
    "web",
    "convex"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace web --if-present",
    "dev:convex": "convex dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run check:env && npm run test --workspaces --if-present",
    "check:env": "node scripts/check-env-example.mjs"
  }
}

# Smart Fundis: every env var name from docs/PRD.md section 7, with no values.
# Never put a real value in this file. `npm run check:env` enforces that.

# web (Vercel)
# Local: web/.env.local (git-ignored). Deployed: Vercel project env vars.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (set with npx convex env set)
# Set separately on the dev and prod deployments. Not read from any file.
CLERK_FRONTEND_API_URL=
AI_SHARED_SECRET=
ADMIN_EMAILS=

# Brev (ai-service, never in this repo)
# Lives only in the env on the Brev box. Listed here so the names are known.
VLLM_BASE_URL=
COSMOS_MODEL=
NVIDIA_API_KEY=
NEMOTRON_MODEL=
CONVEX_SITE_URL=
AI_SHARED_SECRET=
REDIS_URL=
QUEUE_MODE=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
